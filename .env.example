# Optional Google Drive appDataFolder backup (separate from native Firebase login).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# HTTPS Firebase Cloud Function URL, deployed from functions/index.js.
VITE_ECONOMY_API_URL=https://us-central1-nightfall-b49be.cloudfunctions.net/economy

# Flutterwave credentials are SERVER-SIDE Firebase Functions secrets only.
# Never add these to VITE_ variables or the Android app bundle.
# Configure with Firebase CLI (values are prompted securely):
# firebase functions:secrets:set FLW_CLIENT_ID
# firebase functions:secrets:set FLW_SECRET_KEY
# firebase functions:secrets:set FLW_ENCRYPTION_KEY
# firebase functions:secrets:set FLW_WEBHOOK_HASH
#
# Hosted checkout currently uses the legacy Flutterwave Standard v3 endpoint.
# Do not describe this as Flutterwave v4 until the account's v4 contract and
# OAuth client-credentials flow have been implemented and tested end-to-end.
